@page "/categorias"
@inject CategoriaService Categorias
@inject NavigationManager Nav

<PageTitle>Categorias — SalgadosPro</PageTitle>

<div class="page-header">
    <div>
        <h1>Categorias</h1>
        <p class="subtitle">@_lista.Count(c => c.Ativo) ativas</p>
    </div>
    <a href="/categorias/novo" class="btn btn-primary">+ Nova Categoria</a>
</div>

@if (!string.IsNullOrEmpty(_mensagem))
{
    <div class="card" style="margin-bottom:16px;padding:12px 16px;border-left:4px solid var(--terracota)">@_mensagem</div>
}

<div class="card table-card">
    <div class="table-toolbar">
        <div class="search-input">
            <span>🔍</span>
            <input placeholder="Pesquisar categoria..." @bind="_busca" @bind:event="oninput" @onkeyup="Filtrar" />
        </div>
        <button class="btn btn-secondary" @onclick="Filtrar">Buscar</button>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ordem</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_carregando)
            {
                <tr><td colspan="4">Carregando...</td></tr>
            }
            else if (_filtrados.Count == 0)
            {
                <tr><td colspan="4">Nenhuma categoria encontrada.</td></tr>
            }
            else
            {
                @foreach (var c in _filtrados)
                {
                    <tr>
                        <td>
                            <strong>@c.Nome</strong>
                            @if (!string.IsNullOrWhiteSpace(c.Descricao))
                            {
                                <div style="font-size:12px;color:var(--text-muted)">@c.Descricao</div>
                            }
                        </td>
                        <td>@c.Ordem</td>
                        <td><span class="badge @(c.Ativo ? "badge-ativo" : "badge-inativo")">@(c.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td>
                            <button class="btn-icon" title="Editar" @onclick="() => Editar(c.Id)">✏️</button>
                            <button class="btn-icon" title="@(c.Ativo ? "Inativar" : "Ativar")" @onclick="() => Alternar(c.Id)">@(c.Ativo ? "⏸" : "▶")</button>
                            <button class="btn-icon" title="Excluir" @onclick="() => Excluir(c.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<CategoriaProduto> _lista = [];
    private List<CategoriaProduto> _filtrados = [];
    private string _busca = "";
    private string? _mensagem;
    private bool _carregando = true;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        _carregando = true;
        _lista = await Categorias.ListarAsync();
        Filtrar();
        _carregando = false;
    }

    private void Filtrar()
    {
        _filtrados = string.IsNullOrWhiteSpace(_busca)
            ? _lista
            : _lista.Where(c => c.Nome.Contains(_busca, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void Editar(int id) => Nav.NavigateTo($"/categorias/editar/{id}");

    private async Task Alternar(int id)
    {
        try
        {
            await Categorias.AlternarAtivoAsync(id);
            _mensagem = null;
            await Carregar();
        }
        catch (Exception ex)
        {
            _mensagem = ex.Message;
        }
    }

    private async Task Excluir(int id)
    {
        try
        {
            await Categorias.ExcluirAsync(id);
            _mensagem = "Categoria excluída.";
            await Carregar();
        }
        catch (Exception ex)
        {
            _mensagem = ex.Message;
        }
    }
}

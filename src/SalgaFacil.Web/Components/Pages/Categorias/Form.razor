@page "/categorias/novo"
@page "/categorias/editar/{Id:int}"
@rendermode InteractiveServer
@inject CategoriaService Categorias
@inject NavigationManager Nav

<PageTitle>@(_editando ? "Editar" : "Nova") Categoria — SalgadosPro</PageTitle>

<div class="page-header">
    <div><h1>@(_editando ? "Editar Categoria" : "Nova Categoria")</h1></div>
    <a href="/categorias" class="btn btn-secondary">← Voltar</a>
</div>

@if (!string.IsNullOrEmpty(_erro))
{
    <div class="card" style="margin-bottom:16px;padding:12px 16px;border-left:4px solid #c0392b">@_erro</div>
}

<div class="card form-card">
    <EditForm Model="_categoria" OnValidSubmit="Salvar">
        <div class="form-group">
            <label>Nome *</label>
            <InputText class="form-control" @bind-Value="_categoria.Nome" placeholder="Ex: Fritos" maxlength="100" />
        </div>
        <div class="form-group">
            <label>Descrição</label>
            <InputTextArea class="form-control" @bind-Value="_categoria.Descricao" rows="3" maxlength="500" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Ordem</label>
                <InputNumber class="form-control" @bind-Value="_categoria.Ordem" />
            </div>
            <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:8px">
                <label><InputCheckbox @bind-Value="_categoria.Ativo" /> Categoria ativa</label>
            </div>
        </div>
        <div style="display:flex;gap:12px">
            <a href="/categorias" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">@(_salvando ? "Salvando..." : "Salvar")</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private CategoriaProduto _categoria = new() { Ativo = true, Ordem = 1 };
    private bool _editando;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            _editando = true;
            var c = await Categorias.ObterAsync(Id);
            if (c != null) _categoria = c;
        }
    }

    private async Task Salvar()
    {
        _salvando = true;
        _erro = null;
        try
        {
            await Categorias.SalvarAsync(_categoria);
            Nav.NavigateTo("/categorias");
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }
}

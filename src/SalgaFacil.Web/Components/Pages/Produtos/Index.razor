@page "/produtos"
@rendermode InteractiveServer
@inject ProdutoService Produtos
@inject CategoriaService Categorias
@inject NavigationManager Nav

<PageTitle>Produtos — SalgadosPro</PageTitle>

<div class="page-header">
    <div>
        <h1>Produtos</h1>
        <p class="subtitle">@_lista.Count(p => p.Ativo) ativos</p>
    </div>
    <a href="/produtos/novo" class="btn btn-primary">+ Novo Produto</a>
</div>

@if (!string.IsNullOrEmpty(_mensagem))
{
    <div class="card" style="margin-bottom:16px;padding:12px 16px;border-left:4px solid var(--terracota)">@_mensagem</div>
}

<div class="card table-card">
    <div class="table-toolbar" style="flex-wrap:wrap;gap:10px">
        <div class="search-input">
            <span>🔍</span>
            <input placeholder="Pesquisar por nome ou código..." @bind="_busca" @bind:event="oninput" />
        </div>
        <select class="form-control" style="width:auto;min-width:160px" @bind="_categoriaId">
            <option value="0">Todas categorias</option>
            @foreach (var c in _categorias)
            {
                <option value="@c.Id">@c.Nome</option>
            }
        </select>
        <select class="form-control" style="width:auto;min-width:120px" @bind="_statusTexto">
            <option value="">Todos status</option>
            <option value="true">Ativos</option>
            <option value="false">Inativos</option>
        </select>
        <button class="btn btn-secondary" @onclick="AplicarFiltros">Pesquisar</button>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Unidade</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_carregando)
            {
                <tr><td colspan="8">Carregando...</td></tr>
            }
            else if (_lista.Count == 0)
            {
                <tr><td colspan="8">Nenhum produto encontrado.</td></tr>
            }
            else
            {
                @foreach (var p in _lista)
                {
                    <tr>
                        <td>@(p.Codigo ?? "—")</td>
                        <td><strong>@p.Nome</strong></td>
                        <td>@(p.Categoria?.Nome ?? "—")</td>
                        <td>@(p.UnidadeMedida?.Sigla ?? "—")</td>
                        <td class="valor">@p.PrecoVenda.ToString("C", _ptBr)</td>
                        <td>
                            <span class="badge @(p.EstoqueAtual <= 0 ? "badge-inativo" : p.EstoqueAtual <= p.EstoqueMinimo ? "badge-aguardando" : "badge-ativo")">
                                @FormatEstoque(p)
                            </span>
                        </td>
                        <td><span class="badge @(p.Ativo ? "badge-ativo" : "badge-inativo")">@(p.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td>
                            <button class="btn-icon" title="Editar" @onclick="() => Editar(p.Id)">✏️</button>
                            <button class="btn-icon" title="@(p.Ativo ? "Inativar" : "Ativar")" @onclick="() => Alternar(p.Id)">@(p.Ativo ? "⏸" : "▶")</button>
                            <button class="btn-icon" title="Excluir" @onclick="() => Excluir(p.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<Produto> _lista = [];
    private List<CategoriaProduto> _categorias = [];
    private string _busca = "";
    private int _categoriaId;
    private string _statusTexto = "";
    private string? _mensagem;
    private bool _carregando = true;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");

    protected override async Task OnInitializedAsync()
    {
        _categorias = await Categorias.ListarAsync();
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        _carregando = true;
        bool? status = _statusTexto switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
        int? cat = _categoriaId > 0 ? _categoriaId : null;
        _lista = await Produtos.ListarAsync(apenasAtivos: status, categoriaId: cat, busca: _busca);
        _carregando = false;
    }

    private static string FormatEstoque(Produto p)
    {
        var sigla = p.UnidadeMedida?.Sigla ?? "";
        var qtd = p.EstoqueAtual == Math.Truncate(p.EstoqueAtual)
            ? ((int)p.EstoqueAtual).ToString()
            : p.EstoqueAtual.ToString("0.###");
        return string.IsNullOrEmpty(sigla) ? qtd : $"{qtd} {sigla}";
    }

    private void Editar(int id) => Nav.NavigateTo($"/produtos/editar/{id}");

    private async Task Alternar(int id)
    {
        try
        {
            await Produtos.AlternarAtivoAsync(id);
            _mensagem = null;
            await AplicarFiltros();
        }
        catch (Exception ex) { _mensagem = ex.Message; }
    }

    private async Task Excluir(int id)
    {
        try
        {
            await Produtos.ExcluirAsync(id);
            _mensagem = "Produto excluído.";
            await AplicarFiltros();
        }
        catch (Exception ex) { _mensagem = ex.Message; }
    }
}

@page "/loja/{Slug}/carrinho"
@layout SalgaFacil.Web.Components.Layout.PublicLayout
@inject LojaPublicaService Loja
@inject CarrinhoSessao Sacola
@inject NavigationManager Nav

<PageTitle>Carrinho — @(_empresa?.NomeFantasia ?? "Loja")</PageTitle>

@if (_empresa is null)
{
    <div class="loja-empty"><h1>Loja não encontrada</h1><a href="/" class="btn btn-primary">Voltar</a></div>
}
else
{
    <div class="loja-checkout">
        <a href="/loja/@Slug" class="btn btn-secondary">← Cardápio</a>
        <LojaNav Slug="@Slug" />
        <h1>Seu pedido</h1>

        @if (_carregandoCarrinho)
        {
            <p class="loja-loading">Carregando carrinho...</p>
        }
        else if (_linhas.Count == 0 && _pedidoId == 0)
        {
            <p class="loja-empty-msg">Carrinho vazio.</p>
        }
        else if (_linhas.Count > 0)
        {
            <div class="card" style="margin-bottom:16px">
                <table class="data-table">
                    <thead><tr><th>Produto</th><th>Qtd</th><th>Preço</th><th>Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var l in _linhas)
                        {
                            <tr>
                                <td>@l.Nome</td>
                                <td>
                                    <button class="btn-icon" @onclick="() => Alterar(l.ProdutoId, -1)">−</button>
                                    @l.Quantidade
                                    <button class="btn-icon" @onclick="() => Alterar(l.ProdutoId, 1)">+</button>
                                </td>
                                <td>@l.Preco.ToString("C", _ptBr)</td>
                                <td>@((l.Preco * l.Quantidade).ToString("C", _ptBr))</td>
                                <td><button class="btn-icon" @onclick="() => Remover(l.ProdutoId)">🗑️</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p style="text-align:right;font-weight:700;margin-top:12px">Total: @_linhas.Sum(l => l.Preco * l.Quantidade).ToString("C", _ptBr)</p>
                <p style="text-align:right;margin-top:8px">
                    <button type="button" class="link-action" @onclick="EsvaziarCarrinho">Esvaziar carrinho</button>
                </p>
            </div>

            <div class="card" style="margin-bottom:16px">
                <h2 style="font-size:16px;margin-bottom:12px">Seus dados</h2>
                <div class="form-group">
                    <label>Nome *</label>
                    <InputText class="form-control" @bind-Value="_pedido.Nome" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Telefone</label>
                        <InputText class="form-control" @bind-Value="_pedido.Telefone" />
                    </div>
                    <div class="form-group">
                        <label>WhatsApp</label>
                        <InputText class="form-control" @bind-Value="_pedido.WhatsApp" />
                    </div>
                </div>
                <div class="form-group">
                    <label>E-mail <span style="font-weight:400;color:var(--text-muted)">(opcional)</span></label>
                    <InputText class="form-control" type="email" @bind-Value="_pedido.Email" placeholder="voce@exemplo.com" />
                </div>
                <div class="form-group">
                    <label><input type="radio" name="modo" checked="@(!_pedido.Entrega)" @onchange="() => _pedido.Entrega = false" /> Retirada</label>
                    <label style="margin-left:16px"><input type="radio" name="modo" checked="@_pedido.Entrega" @onchange="() => _pedido.Entrega = true" /> Entrega</label>
                </div>
                @if (_pedido.Entrega)
                {
                    <div class="form-group">
                        <label>Endereço de entrega</label>
                        <InputText class="form-control" @bind-Value="_pedido.EnderecoEntrega" />
                    </div>
                }
                <div class="form-group" style="margin-bottom:0">
                    <label>Observações</label>
                    <InputTextArea class="form-control" @bind-Value="_pedido.Observacoes" rows="2" />
                </div>
            </div>

            <div class="card">
                <h2 style="font-size:16px;margin-bottom:12px">Forma de pagamento</h2>
                <div class="pm-pagamento-grid" style="margin-bottom:16px">
                    @foreach (var forma in FormasDisponiveis)
                    {
                        <button type="button" class="pm-pagamento-card @(_pedido.FormaPagamento == forma ? "active" : "")" @onclick="() => _pedido.FormaPagamento = forma">
                            <span class="pm-pagamento-icone">@forma.Icone()</span>
                            <span>@forma.Rotulo()</span>
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_erro))
                {
                    <div class="login-error" style="margin-bottom:16px">@_erro</div>
                }
                <button class="btn btn-primary" disabled="@_enviando" @onclick="Enviar">@(_enviando ? "Enviando..." : "Confirmar pedido")</button>
            </div>
        }

        @if (_pedidoId > 0)
        {
            <div class="card" style="margin-top:16px;padding:16px;border-left:4px solid var(--green)">
                Pedido <strong>#@_pedidoId</strong> enviado com sucesso!
                @if (_clienteJaExistia)
                {
                    <p style="margin-top:8px;color:var(--text-muted);font-size:13px">Encontramos seu cadastro. Seus dados foram utilizados neste pedido.</p>
                }
                <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
                    @if (_linkWhatsApp is not null)
                    {
                        <a class="btn btn-primary" href="@_linkWhatsApp" target="_blank" rel="noopener">📱 Acompanhar pelo WhatsApp</a>
                    }
                    <a class="btn btn-secondary" href="/loja/@Slug">Voltar ao cardápio</a>
                    <a class="btn btn-secondary" href="/loja/@Slug/meus-pedidos">Ver meus pedidos</a>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Empresa? _empresa;
    private List<Linha> _linhas = [];
    private PedidoVisitanteDto _pedido = new();
    private string? _erro;
    private bool _enviando;
    private int _pedidoId;
    private bool _clienteJaExistia;
    private bool _carregandoCarrinho = true;
    private string? _linkWhatsApp;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private static readonly FormaPagamento[] FormasDisponiveis =
        [FormaPagamento.Pix, FormaPagamento.Dinheiro, FormaPagamento.CartaoDebito, FormaPagamento.CartaoCredito];

    protected override async Task OnInitializedAsync()
    {
        _empresa = await Loja.ObterEmpresaPorSlugAsync(Slug);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _empresa == null) return;

        // JS interop (localStorage) só funciona depois que o circuito está interativo —
        // por isso o carrinho é carregado aqui, não em OnInitializedAsync.
        await Sacola.CarregarAsync(Slug);
        await MontarLinhas();
        _carregandoCarrinho = false;
        StateHasChanged();
    }

    private async Task MontarLinhas()
    {
        var itens = Sacola.Obter(Slug);
        if (_empresa == null || itens.Count == 0) { _linhas = []; return; }
        var produtos = await Loja.ListarProdutosAsync(_empresa.Id);
        _linhas = itens
            .Select(i =>
            {
                var p = produtos.FirstOrDefault(x => x.Id == i.ProdutoId);
                return p == null ? null : new Linha { ProdutoId = p.Id, Nome = p.Nome, Preco = PrecificacaoProduto.PrecoUnitario(p, i.Quantidade), Quantidade = i.Quantidade };
            })
            .Where(l => l != null)
            .Cast<Linha>()
            .ToList();
    }

    private async Task Alterar(int produtoId, int delta)
    {
        var itens = Sacola.Obter(Slug);
        var item = itens.FirstOrDefault(i => i.ProdutoId == produtoId);
        if (item == null) return;
        item.Quantidade += delta;
        if (item.Quantidade <= 0) itens.Remove(item);
        await Sacola.DefinirAsync(Slug, itens);
        await MontarLinhas();
    }

    private async Task Remover(int produtoId)
    {
        var itens = Sacola.Obter(Slug).Where(i => i.ProdutoId != produtoId).ToList();
        await Sacola.DefinirAsync(Slug, itens);
        await MontarLinhas();
    }

    private async Task EsvaziarCarrinho()
    {
        await Sacola.LimparAsync(Slug);
        _linhas = [];
    }

    /// <summary>
    /// Monta o link "https://wa.me/..." para o cliente falar com a loja sobre o pedido recém-criado.
    /// Reaproveita TelefoneNormalizador (mesma normalização usada para Cliente) porque o formato
    /// que o wa.me espera — dígitos puros com DDI — é exatamente o que ele já produz.
    /// Retorna null se a loja não tiver WhatsApp cadastrado (Empresa.WhatsApp), caso em que o
    /// botão simplesmente não aparece na tela de confirmação.
    /// </summary>
    private static string? MontarLinkWhatsApp(string? whatsappLoja, int pedidoId)
    {
        var numero = TelefoneNormalizador.Normalizar(whatsappLoja);
        if (numero is null) return null;

        var mensagem = Uri.EscapeDataString($"Olá! Acabei de fazer o pedido #{pedidoId:D4}.");
        return $"https://wa.me/{numero}?text={mensagem}";
    }

    private async Task Enviar()
    {
        if (_empresa == null) return;
        if (_pedido.FormaPagamento is null)
        {
            _erro = "Selecione a forma de pagamento.";
            return;
        }

        _enviando = true;
        _erro = null;
        try
        {
            _pedido.Itens = Sacola.Obter(Slug).ToList();
            var resultado = await Loja.CriarPedidoVisitanteAsync(_empresa.Id, _pedido);
            _pedidoId = resultado.PedidoId;
            _clienteJaExistia = resultado.ClienteJaExistia;
            _linkWhatsApp = MontarLinkWhatsApp(_empresa.WhatsApp, resultado.PedidoId);
            await Sacola.LimparAsync(Slug);
            _linhas = [];
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _enviando = false; }
    }

    private class Linha
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = "";
        public decimal Preco { get; set; }
        public int Quantidade { get; set; }
    }
}

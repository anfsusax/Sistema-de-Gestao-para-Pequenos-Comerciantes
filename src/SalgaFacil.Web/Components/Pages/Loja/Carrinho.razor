@page "/loja/{Slug}/carrinho"
@layout SalgaFacil.Web.Components.Layout.PublicLayout
@inject LojaPublicaService Loja
@inject CarrinhoSessao Sacola
@inject ClienteAuthService ClienteAuth
@inject IPagamentoPixService PagamentoPix

<PageTitle>Checkout — @(_empresa?.NomeFantasia ?? "Loja")</PageTitle>

@if (_empresa is null)
{
    <div class="loja-empty"><h1>Loja não encontrada</h1><a href="/" class="btn btn-primary">Voltar</a></div>
}
else
{
    <div class="loja-checkout">
        <a href="/loja/@Slug" class="btn btn-secondary">← Cardápio</a>
        <LojaNav Slug="@Slug" />
        <h1>@TituloEtapa</h1>

        @if (_carregandoCarrinho)
        {
            <p class="loja-loading">Carregando carrinho...</p>
        }
        else if (_linhas.Count == 0 && _pedidoId == 0)
        {
            <p class="loja-empty-msg">Carrinho vazio.</p>
        }
        else if (_etapa == EtapaCheckout.Resumo)
        {
            <div class="card" style="margin-bottom:16px">
                <table class="data-table">
                    <thead><tr><th>Produto</th><th>Qtd</th><th>Preço</th><th>Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var linha in _linhas)
                        {
                            <tr>
                                <td>@linha.Nome</td>
                                <td>
                                    <button class="btn-icon" @onclick="() => Alterar(linha.ProdutoId, -1)">−</button>
                                    @linha.Quantidade
                                    <button class="btn-icon" @onclick="() => Alterar(linha.ProdutoId, 1)">+</button>
                                </td>
                                <td>@linha.Preco.ToString("C", _ptBr)</td>
                                <td>@((linha.Preco * linha.Quantidade).ToString("C", _ptBr))</td>
                                <td><button class="btn-icon" title="Remover" @onclick="() => Remover(linha.ProdutoId)">×</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p style="text-align:right;font-weight:700;margin-top:12px">Total: @Total.ToString("C", _ptBr)</p>
                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px;flex-wrap:wrap">
                    <button type="button" class="btn btn-secondary" @onclick="EsvaziarCarrinho">Esvaziar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmarCarrinho">Confirmar compra</button>
                </div>
            </div>
        }
        else if (_etapa == EtapaCheckout.Identificacao)
        {
            <div class="card checkout-auth">
                <p style="margin-bottom:16px">Para continuar com a compra, entre na sua conta ou faça seu cadastro.</p>
                <div style="display:flex;gap:8px;margin-bottom:18px">
                    <button type="button" class="btn @(!_modoCadastro ? "btn-primary" : "btn-secondary")" @onclick="() => TrocarModo(false)">Entrar</button>
                    <button type="button" class="btn @(_modoCadastro ? "btn-primary" : "btn-secondary")" @onclick="() => TrocarModo(true)">Criar conta</button>
                </div>

                @if (!_modoCadastro)
                {
                    <div class="form-group"><label>E-mail</label><InputText type="email" class="form-control" @bind-Value="_login.Email" /></div>
                    <div class="form-group"><label>Senha</label><InputText type="password" class="form-control" @bind-Value="_login.Senha" /></div>
                    <button type="button" class="btn btn-primary" disabled="@_processando" @onclick="Entrar">@(_processando ? "Entrando..." : "Entrar e continuar")</button>
                }
                else
                {
                    <div class="form-group"><label>Nome</label><InputText class="form-control" @bind-Value="_cadastro.Nome" /></div>
                    <div class="form-row">
                        <div class="form-group"><label>E-mail</label><InputText type="email" class="form-control" @bind-Value="_cadastro.Email" /></div>
                        <div class="form-group"><label>Telefone</label><InputText class="form-control" @bind-Value="_cadastro.Telefone" /></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group"><label>Senha</label><InputText type="password" class="form-control" @bind-Value="_cadastro.Senha" /></div>
                        <div class="form-group"><label>Confirmar senha</label><InputText type="password" class="form-control" @bind-Value="_cadastro.Confirmacao" /></div>
                    </div>
                    <button type="button" class="btn btn-primary" disabled="@_processando" @onclick="Cadastrar">@(_processando ? "Cadastrando..." : "Cadastrar e continuar")</button>
                }
                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <div class="login-error" style="margin-top:16px">@_erro</div>
                }
            </div>
        }
        else if (_etapa == EtapaCheckout.Pagamento)
        {
            <div class="card" style="margin-bottom:16px">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
                    <div><strong>@ClienteAuth.ClienteAtual?.Nome</strong><br /><small>@ClienteAuth.ClienteAtual?.Email</small></div>
                    <button type="button" class="btn btn-secondary" @onclick="TrocarConta">Trocar conta</button>
                </div>
            </div>
            <div class="card" style="margin-bottom:16px">
                <h2 style="font-size:16px;margin-bottom:12px">Recebimento do pedido</h2>
                <div class="form-group">
                    <label><input type="radio" name="modo" checked="@(!_pedido.Entrega)" @onchange="() => _pedido.Entrega = false" /> Retirada</label>
                    <label style="margin-left:16px"><input type="radio" name="modo" checked="@_pedido.Entrega" @onchange="() => _pedido.Entrega = true" /> Entrega</label>
                </div>
                @if (_pedido.Entrega)
                {
                    <div class="form-group"><label>Endereço de entrega</label><InputText class="form-control" @bind-Value="_pedido.EnderecoEntrega" /></div>
                }
                <div class="form-group" style="margin-bottom:0"><label>Observações</label><InputTextArea class="form-control" @bind-Value="_pedido.Observacoes" rows="2" /></div>
            </div>
            <div class="card">
                <h2 style="font-size:16px;margin-bottom:12px">Forma de pagamento</h2>
                <div class="pm-pagamento-grid" style="margin-bottom:16px">
                    @foreach (var forma in FormasDisponiveis)
                    {
                        <button type="button" class="pm-pagamento-card @(_pedido.FormaPagamento == forma ? "active" : "")" @onclick="() => _pedido.FormaPagamento = forma">
                            <span class="pm-pagamento-icone">@forma.Icone()</span><span>@forma.Rotulo()</span>
                        </button>
                    }
                </div>
                <p style="font-weight:700;margin-bottom:14px">Total: @Total.ToString("C", _ptBr)</p>
                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <div class="login-error" style="margin-bottom:16px">@_erro</div>
                }
                <button type="button" class="btn btn-primary" disabled="@_processando" @onclick="FinalizarPedido">@(_processando ? "Finalizando..." : "Finalizar pedido")</button>
            </div>
        }
        else if (_etapa == EtapaCheckout.Pix)
        {
            <div class="card" style="margin-bottom:16px;border-left:4px solid var(--green)">
                <strong>Pedido #@_pedidoId criado.</strong> Agora faça o pagamento para concluir.
            </div>
            <PagamentoPixClienteCard Pagamento="@_pagamentoPix" Carregando="@_carregandoPix" Erro="@_erroPix" />
            <div style="display:flex;gap:8px;margin-top:16px;flex-wrap:wrap">
                <a class="btn btn-secondary" href="/loja/@Slug/meus-pedidos">Ver meus pedidos</a>
                <a class="btn btn-secondary" href="/loja/@Slug">Voltar ao cardápio</a>
            </div>
        }
        else if (_etapa == EtapaCheckout.Concluido)
        {
            <div class="card" style="border-left:4px solid var(--green)">
                Pedido <strong>#@_pedidoId</strong> enviado com sucesso!
                <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
                    <a class="btn btn-secondary" href="/loja/@Slug">Voltar ao cardápio</a>
                    <a class="btn btn-secondary" href="/loja/@Slug/meus-pedidos">Ver meus pedidos</a>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Empresa? _empresa;
    private List<Linha> _linhas = [];
    private PedidoClienteDto _pedido = new();
    private LoginModel _login = new();
    private CadastroModel _cadastro = new();
    private EtapaCheckout _etapa = EtapaCheckout.Resumo;
    private bool _modoCadastro;
    private bool _processando;
    private bool _carregandoCarrinho = true;
    private bool _carregandoPix;
    private string? _erro;
    private string? _erroPix;
    private int _pedidoId;
    private PagamentoPixDto? _pagamentoPix;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private static readonly FormaPagamento[] FormasDisponiveis =
        [FormaPagamento.Pix, FormaPagamento.Dinheiro, FormaPagamento.CartaoDebito, FormaPagamento.CartaoCredito];

    private decimal Total => _linhas.Sum(l => l.Preco * l.Quantidade);
    private string TituloEtapa => _etapa switch
    {
        EtapaCheckout.Resumo => "Seu carrinho",
        EtapaCheckout.Identificacao => "Identificação",
        EtapaCheckout.Pagamento => "Pagamento",
        EtapaCheckout.Pix => "Pagamento Pix",
        _ => "Pedido confirmado"
    };

    protected override async Task OnInitializedAsync() => _empresa = await Loja.ObterEmpresaPorSlugAsync(Slug);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _empresa is null) return;
        await Sacola.CarregarAsync(Slug);
        await MontarLinhas();
        _carregandoCarrinho = false;
        StateHasChanged();
    }

    private async Task MontarLinhas()
    {
        var itens = Sacola.Obter(Slug);
        if (_empresa is null || itens.Count == 0) { _linhas = []; return; }
        var produtos = await Loja.ListarProdutosAsync(_empresa.Id);
        _linhas = itens.Select(i =>
        {
            var produto = produtos.FirstOrDefault(p => p.Id == i.ProdutoId);
            return produto is null ? null : new Linha
            {
                ProdutoId = produto.Id, Nome = produto.Nome,
                Preco = PrecificacaoProduto.PrecoUnitario(produto, i.Quantidade), Quantidade = i.Quantidade
            };
        }).Where(l => l is not null).Cast<Linha>().ToList();
    }

    private async Task Alterar(int produtoId, int delta)
    {
        var itens = Sacola.Obter(Slug);
        var item = itens.FirstOrDefault(i => i.ProdutoId == produtoId);
        if (item is null) return;
        item.Quantidade += delta;
        if (item.Quantidade <= 0) itens.Remove(item);
        await Sacola.DefinirAsync(Slug, itens);
        await MontarLinhas();
    }

    private async Task Remover(int produtoId)
    {
        await Sacola.DefinirAsync(Slug, Sacola.Obter(Slug).Where(i => i.ProdutoId != produtoId).ToList());
        await MontarLinhas();
    }

    private async Task EsvaziarCarrinho()
    {
        await Sacola.LimparAsync(Slug);
        _linhas = [];
    }

    private void ConfirmarCarrinho()
    {
        if (_empresa is null || _linhas.Count == 0) return;
        _erro = null;
        _etapa = ClienteAuth.EstaAutenticado(_empresa.Id) ? EtapaCheckout.Pagamento : EtapaCheckout.Identificacao;
    }

    private void TrocarModo(bool cadastro)
    {
        _modoCadastro = cadastro;
        _erro = null;
    }

    private async Task Entrar()
    {
        if (_empresa is null) return;
        _processando = true;
        _erro = null;
        try
        {
            if (!await ClienteAuth.LoginAsync(_empresa.Id, _login.Email, _login.Senha))
                _erro = "E-mail ou senha inválidos.";
            else
                _etapa = EtapaCheckout.Pagamento;
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _processando = false; }
    }

    private async Task Cadastrar()
    {
        if (_empresa is null) return;
        if (_cadastro.Senha != _cadastro.Confirmacao) { _erro = "As senhas não conferem."; return; }
        _processando = true;
        _erro = null;
        try
        {
            await ClienteAuth.CadastrarAsync(_empresa.Id, _cadastro.Nome, _cadastro.Email, _cadastro.Telefone, _cadastro.Senha);
            _etapa = EtapaCheckout.Pagamento;
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _processando = false; }
    }

    private void TrocarConta()
    {
        ClienteAuth.Sair();
        _login = new();
        _erro = null;
        _etapa = EtapaCheckout.Identificacao;
    }

    private async Task FinalizarPedido()
    {
        if (_empresa is null || ClienteAuth.ClienteAtual is null) return;
        if (_pedido.FormaPagamento is null) { _erro = "Selecione a forma de pagamento."; return; }
        if (_pedido.Entrega && string.IsNullOrWhiteSpace(_pedido.EnderecoEntrega)) { _erro = "Informe o endereço de entrega."; return; }

        _processando = true;
        _erro = null;
        try
        {
            _pedido.Itens = Sacola.Obter(Slug).ToList();
            _pedidoId = await Loja.CriarPedidoClienteAsync(_empresa.Id, ClienteAuth.ClienteAtual.Id, _pedido);
            await Sacola.LimparAsync(Slug);
            _linhas = [];

            if (_pedido.FormaPagamento == FormaPagamento.Pix)
            {
                _etapa = EtapaCheckout.Pix;
                _carregandoPix = true;
                try
                {
                    _pagamentoPix = await PagamentoPix.ObterParaClienteAsync(
                        _empresa.Id, _pedidoId, ClienteAuth.ClienteAtual.Telefone);
                }
                catch (Exception ex) { _erroPix = ex.Message; }
                finally { _carregandoPix = false; }
            }
            else
            {
                _etapa = EtapaCheckout.Concluido;
            }
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _processando = false; }
    }

    private enum EtapaCheckout { Resumo, Identificacao, Pagamento, Pix, Concluido }
    private sealed class LoginModel { public string Email { get; set; } = ""; public string Senha { get; set; } = ""; }
    private sealed class CadastroModel
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefone { get; set; } = "";
        public string Senha { get; set; } = "";
        public string Confirmacao { get; set; } = "";
    }
    private sealed class Linha
    {
        public int ProdutoId { get; set; }
        public string Nome { get; set; } = "";
        public decimal Preco { get; set; }
        public int Quantidade { get; set; }
    }
}
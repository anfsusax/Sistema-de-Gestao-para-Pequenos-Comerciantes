@page "/loja/{Slug}"
@layout SalgaFacil.Web.Components.Layout.PublicLayout
@inject LojaPublicaService Loja
@inject CarrinhoSessao Carrinho
@inject ILogger<Index> _logger

<PageTitle>@(_empresa?.NomeFantasia ?? _empresa?.Nome ?? "Cardápio")</PageTitle>

@if (_carregando)
{
    <p class="loja-loading">Carregando cardápio...</p>
}
else if (_empresa is null)
{
    <div class="loja-empty">
        <h1>Loja não encontrada</h1>
        <p>Verifique o link ou volte à página inicial.</p>
        <a href="/" class="btn btn-primary">Voltar</a>
    </div>
}
else
{
    <header class="loja-header">
        <div class="loja-header-inner">
            <div>
                <p class="loja-eyebrow">Cardápio</p>
                <h1>@(_empresa.NomeFantasia ?? _empresa.Nome)</h1>
                @if (!string.IsNullOrWhiteSpace(_empresa.Descricao))
                {
                    <p class="loja-desc">@_empresa.Descricao</p>
                }
            </div>
            <LojaNav Slug="@Slug" />
        </div>
        <div class="loja-meta">
            @if (!string.IsNullOrWhiteSpace(_empresa.HorarioFuncionamento))
            {
                <span>🕒 @_empresa.HorarioFuncionamento</span>
            }
            @if (!string.IsNullOrWhiteSpace(_empresa.Endereco))
            {
                <span>📍 @_empresa.Endereco</span>
            }
            @if (!string.IsNullOrWhiteSpace(_empresa.WhatsApp))
            {
                <span>📱 @_empresa.WhatsApp</span>
            }
        </div>
    </header>

    <div class="loja-filters">
        <button class="chip @(_categoriaId == null ? "active" : "")" @onclick="() => Filtrar(null)">Todos</button>
        @foreach (var c in _categorias)
        {
            <button class="chip @(_categoriaId == c.Id ? "active" : "")" @onclick="() => Filtrar(c.Id)">@c.Nome</button>
        }
    </div>

    @if (_produtos.Count == 0)
    {
        <p class="loja-empty-msg">Nenhum produto disponível no momento. Cadastre produtos no painel administrativo.</p>
    }
    else
    {
        <div class="loja-grid">
            @foreach (var p in _produtos)
            {
                <article class="loja-card">
                    @if (!string.IsNullOrWhiteSpace(p.FotoUrl))
                    {
                        <img src="@p.FotoUrl" alt="@p.Nome" class="loja-card-img" />
                    }
                    else
                    {
                        <div class="loja-card-img loja-card-img--empty">🥟</div>
                    }
                    <div class="loja-card-body">
                        <span class="loja-card-cat">@(p.Categoria?.Nome)</span>
                        <h2>@p.Nome</h2>
                        <div class="loja-card-footer">
                            <strong>@p.PrecoVenda.ToString("C", _ptBr)</strong>
                            <button class="btn btn-primary" type="button" @onclick="() => AbrirSeletor(p)">Adicionar</button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="loja-toast">@_msg</div>
    }

    <SeletorQuantidade Produto="_produtoSelecionado" OnConfirmar="ConfirmarAdicao" OnFechar="FecharSeletor" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Empresa? _empresa;
    private List<CategoriaProduto> _categorias = [];
    private List<Produto> _produtos = [];
    private int? _categoriaId;
    private bool _carregando = true;
    private string? _msg;
    private Produto? _produtoSelecionado;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");

    protected override async Task OnInitializedAsync()
    {
        _empresa = await Loja.ObterEmpresaPorSlugAsync(Slug);
        if (_empresa == null) { _carregando = false; return; }

        _categorias = await Loja.ListarCategoriasAsync(_empresa.Id);
        await Filtrar(null);
        _carregando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // JS interop (localStorage) só funciona depois que o circuito está interativo —
        // por isso o carrinho é carregado aqui, não em OnInitializedAsync.
        await Carrinho.CarregarAsync(Slug);
        StateHasChanged();
    }

    private async Task Filtrar(int? categoriaId)
    {
        _categoriaId = categoriaId;
        if (_empresa != null)
            _produtos = await Loja.ListarProdutosAsync(_empresa.Id, categoriaId);
    }

    private void AbrirSeletor(Produto p) => _produtoSelecionado = p;

    private void FecharSeletor() => _produtoSelecionado = null;

    private async Task ConfirmarAdicao(int quantidade)
    {
        var p = _produtoSelecionado;
        if (p == null || quantidade < PrecificacaoProduto.QuantidadeMinima) return;

        try
        {
            // Se o produto já está no carrinho, soma à quantidade existente
            // em vez de criar uma linha duplicada.
            var itens = Carrinho.Obter(Slug);
            var item = itens.FirstOrDefault(c => c.ProdutoId == p.Id);
            if (item == null) itens.Add(new ItemCarrinhoDto { ProdutoId = p.Id, Quantidade = quantidade });
            else item.Quantidade += quantidade;
            await Carrinho.DefinirAsync(Slug, itens);

            // DIAGNÓSTICO TEMPORÁRIO (2026-07-25) — mostra no próprio toast, sem precisar de
            // console/log do servidor: o total real após este Adicionar, e quantos LojaNav
            // estão inscritos para receber o aviso de mudança. Se "assinantes LojaNav" vier 0,
            // o badge do cabeçalho realmente não tem como saber que o carrinho mudou — aponta
            // para um problema de inscrição/lifecycle no LojaNav.razor, não neste método.
            _msg = $"{quantidade}x {p.Nome} adicionado. Total agora: {Carrinho.QuantidadeTotal(Slug)} | assinantes LojaNav: {Carrinho.AssinantesCarrinhoAlterado}";
        }
        catch (Exception ex)
        {
            // Rede fina de segurança: CarrinhoSessao já trata as falhas esperadas do JS interop
            // internamente (não deveria propagar nada até aqui). Se mesmo assim algo inesperado
            // escapar, não deixamos a exceção subir pela EventCallback e derrubar o circuito —
            // isso era exatamente o bug relatado ("adicionei e o carrinho não atualizou, só
            // recarregando"): sem este catch, o circuito Blazor morre e a página trava até F5.
            _msg = "Não foi possível adicionar o item agora. Tente novamente.";
            _logger.LogError(ex, "Falha ao adicionar produto {ProdutoId} ao carrinho da loja {Slug}", p.Id, Slug);
        }
        finally
        {
            // Fecha o modal e força a atualização do contador no LojaNav (cabeçalho) mesmo no
            // caminho de erro acima — sem isso o usuário ficaria com o modal aberto e nenhum
            // feedback visível de que algo deu errado.
            _produtoSelecionado = null;
            StateHasChanged();
        }
    }
}

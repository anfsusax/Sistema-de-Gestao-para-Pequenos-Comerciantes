@page "/pedidos/{Id:int}"
@inject PedidoService Pedidos
@inject NavigationManager Nav
@inject IPagamentoPixService PagamentoPix

<PageTitle>Pedido #@Id — SalgadosPro</PageTitle>

@if (_pedido == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>Pedido #@_pedido.Id.ToString("D4")</h1>
            <p class="subtitle">@_pedido.Cliente.Nome — @_pedido.Data.ToString("dd/MM/yyyy")</p>
        </div>
        <a href="/pedidos" class="btn btn-secondary">← Voltar</a>
    </div>

    <div class="pedido-detalhe-grid">
        <div class="card">
            <div class="card-title">Itens do Pedido</div>
            <table class="data-table">
                <thead>
                    <tr><th>Produto</th><th>Qtd</th><th>Valor</th><th>Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in _pedido.Itens)
                    {
                        <tr>
                            <td>@i.Descricao</td>
                            <td>@i.Quantidade</td>
                            <td>@i.ValorUnitario.ToString("C", _ptBr)</td>
                            <td class="valor">@i.Total.ToString("C", _ptBr)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:16px;font-size:18px;font-weight:800">Total: @_pedido.Total.ToString("C", _ptBr)</div>
            @if (_pedido.FormaPagamento is not null)
            {
                <p style="margin-top:8px;color:var(--text-muted);font-size:13px">
                    Forma de pagamento: @_pedido.FormaPagamento.Value.Rotulo()
                </p>
            }
        </div>

        <div class="card">
            <div class="card-title">Status operacional</div>
            <p style="margin-bottom:16px"><StatusBadge Status="@_pedido.Status" /></p>
            <div style="display:flex;flex-direction:column;gap:10px">
                @if (_pedido.Status == StatusPedido.Aguardando)
                {
                    <button class="btn btn-primary" @onclick="() => MudarStatus(StatusPedido.EmProducao)">Iniciar Produção</button>
                }
                @if (_pedido.Status == StatusPedido.EmProducao)
                {
                    <button class="btn btn-primary" @onclick="() => MudarStatus(StatusPedido.Pronto)">Finalizar Produção</button>
                }
                @if (_pedido.Status == StatusPedido.Pronto)
                {
                    <button class="btn btn-primary" @onclick="() => MudarStatus(StatusPedido.Entregue)">Marcar Entregue</button>
                }
                @if (_pedido.Status == StatusPedido.Entregue)
                {
                    <button class="btn btn-secondary" @onclick="() => MudarStatus(StatusPedido.Finalizado)">Finalizar</button>
                }
            </div>
            <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border)">
                <p style="font-size:13px;color:var(--text-muted)"><strong>Cliente:</strong> @_pedido.Cliente.Nome</p>
                <p style="font-size:13px;color:var(--text-muted)"><strong>Telefone:</strong> @_pedido.Cliente.Telefone</p>
                @{
                    var end = _pedido.Cliente.Enderecos.FirstOrDefault(e => e.Principal)
                        ?? _pedido.Cliente.Enderecos.FirstOrDefault();
                }
                @if (end != null)
                {
                    <p style="font-size:13px;color:var(--text-muted)">
                        <strong>Endereço:</strong>
                        @end.Logradouro@(string.IsNullOrWhiteSpace(end.Numero) ? "" : $", {end.Numero}") — @end.Cidade/@end.Estado
                    </p>
                }
            </div>

            @if (_pedido.FormaPagamento == FormaPagamento.Pix)
            {
                <ConfirmacaoPagamentoPixCard Pagamento="_pixPagamento"
                                             Carregando="_pixCarregando"
                                             Confirmando="_pixConfirmando"
                                             Erro="@_pixErro"
                                             OnConfirmar="ConfirmarPixAsync" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Pedido? _pedido;
    private PagamentoPixDto? _pixPagamento;
    private bool _pixCarregando;
    private bool _pixConfirmando;
    private string? _pixErro;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");

    protected override async Task OnInitializedAsync()
    {
        _pedido = await Pedidos.ObterAsync(Id);
        await CarregarPixAsync();
    }

    private async Task CarregarPixAsync()
    {
        if (_pedido is null || _pedido.FormaPagamento != FormaPagamento.Pix)
            return;

        _pixCarregando = true;
        _pixErro = null;
        try
        {
            _pixPagamento = await PagamentoPix.ObterParaAdministracaoAsync(Id);
        }
        catch (Exception ex)
        {
            _pixErro = ex.Message;
            _pixPagamento = null;
        }
        finally
        {
            _pixCarregando = false;
        }
    }

    private async Task MudarStatus(StatusPedido status)
    {
        await Pedidos.AtualizarStatusAsync(Id, status);
        _pedido = await Pedidos.ObterAsync(Id);
    }

    private async Task ConfirmarPixAsync()
    {
        _pixConfirmando = true;
        _pixErro = null;
        try
        {
            await PagamentoPix.ConfirmarRecebimentoAsync(Id);
            _pixPagamento = await PagamentoPix.ObterParaAdministracaoAsync(Id);
        }
        catch (Exception ex)
        {
            _pixErro = ex.Message;
        }
        finally
        {
            _pixConfirmando = false;
        }
    }
}

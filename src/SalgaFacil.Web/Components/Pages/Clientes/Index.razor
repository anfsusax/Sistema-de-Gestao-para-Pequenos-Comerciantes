@page "/clientes"
@inject ClienteService Clientes
@inject NavigationManager Nav

<PageTitle>Clientes — SalgadosPro</PageTitle>

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p class="subtitle">@_lista.Count(c => c.Ativo) ativos · @_lista.Count cadastrados</p>
    </div>
    <a href="/clientes/novo" class="btn btn-primary">+ Novo Cliente</a>
</div>

@if (!string.IsNullOrEmpty(_mensagem))
{
    <div class="card" style="margin-bottom:16px;padding:12px 16px;border-left:4px solid var(--terracota)">@_mensagem</div>
}

<div class="card table-card">
    <div class="table-toolbar">
        <div class="search-input">
            <span>🔍</span>
            <input placeholder="Pesquisar nome, telefone ou WhatsApp..." @bind="_busca" @bind:event="oninput" />
        </div>
        <button class="btn btn-secondary" @onclick="Carregar">Pesquisar</button>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>WhatsApp</th>
                <th>Cidade</th>
                <th>Pedidos</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_carregando)
            {
                <tr><td colspan="6">Carregando...</td></tr>
            }
            else if (_lista.Count == 0)
            {
                <tr><td colspan="6">Nenhum cliente encontrado.</td></tr>
            }
            else
            {
                @foreach (var c in _lista)
                {
                    <tr>
                        <td>
                            <div class="row-user">
                                <UserAvatar Nome="@c.Nome" />
                                <strong>@c.Nome</strong>
                            </div>
                        </td>
                        <td>@(c.WhatsApp ?? c.Telefone)</td>
                        <td>@(c.Cidade ?? "—")</td>
                        <td>@c.TotalPedidos</td>
                        <td><span class="badge @(c.Ativo ? "badge-ativo" : "badge-inativo")">@(c.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td>
                            <button class="btn-icon" title="Editar" @onclick="() => Editar(c.Id)">✏️</button>
                            <button class="btn-icon" title="@(c.Ativo ? "Inativar" : "Ativar")" @onclick="() => Alternar(c.Id)">@(c.Ativo ? "⏸" : "▶")</button>
                            <button class="btn-icon" title="Excluir" @onclick="() => Excluir(c.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<ClienteComResumo> _lista = [];
    private string _busca = "";
    private string? _mensagem;
    private bool _carregando = true;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        _carregando = true;
        _lista = await Clientes.ListarComResumoAsync(_busca);
        _carregando = false;
    }

    private void Editar(int id) => Nav.NavigateTo($"/clientes/editar/{id}");

    private async Task Alternar(int id)
    {
        try
        {
            await Clientes.AlternarAtivoAsync(id);
            _mensagem = null;
            await Carregar();
        }
        catch (Exception ex) { _mensagem = ex.Message; }
    }

    private async Task Excluir(int id)
    {
        try
        {
            await Clientes.ExcluirAsync(id);
            _mensagem = "Cliente excluído.";
            await Carregar();
        }
        catch (Exception ex) { _mensagem = ex.Message; }
    }
}

@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav
@layout SalgaFacil.Web.Components.Layout.EmptyLayout

<PageTitle>Login — ConsuCruz</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <div class="brand-icon">🥟</div>
            <h1>Acesso do Comerciante</h1>
            <p>Painel ConsuCruz</p>
        </div>
        @if (!string.IsNullOrEmpty(_erro))
        {
            <div class="login-error">@_erro</div>
        }
        <EditForm Model="_model" OnValidSubmit="Entrar">
            <div class="form-group">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" placeholder="seu@email.com" />
            </div>
            <div class="form-group">
                <label>Senha</label>
                <InputText type="password" class="form-control" @bind-Value="_model.Senha" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px" disabled="@_entrando">
                @(_entrando ? "Entrando..." : "Entrar")
            </button>
        </EditForm>
        <p style="text-align:center;margin-top:16px;font-size:12px;color:var(--text-muted)">
            Demo: maria@salgadospro.com / 123456
        </p>
    </div>
</div>

@code {
    private LoginModel _model = new()
    {
        Email = "maria@salgadospro.com",
        Senha = "123456"
    };
    private string? _erro;
    private bool _entrando;

    private async Task Entrar()
    {
        _erro = null;
        _entrando = true;
        try
        {
            if (await Auth.LoginAsync(_model.Email, _model.Senha))
                Nav.NavigateTo("/dashboard");
            else
                _erro = "Email ou senha incorretos, ou usuário sem empresa vinculada.";
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _entrando = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }
}

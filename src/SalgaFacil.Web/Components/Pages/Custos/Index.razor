@page "/custos"
@rendermode InteractiveServer
@inject CustosService Custos

<PageTitle>Custos — SalgadosPro</PageTitle>

@if (_dados == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>Custos e Finanças</h1>
            <p class="subtitle">Controle financeiro — mês atual</p>
        </div>
    </div>

    <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr)">
        <div class="kpi-card">
            <div class="label">Receita do Mês</div>
            <div class="value green">@_dados.ReceitaMes.ToString("C", _ptBr)</div>
            <div class="sub">@_dados.TotalPedidosMes pedidos</div>
        </div>
        <div class="kpi-card">
            <div class="label">Custo Estimado</div>
            <div class="value terracota">@_dados.CustoEstimadoMes.ToString("C", _ptBr)</div>
            <div class="sub">insumos</div>
        </div>
        <div class="kpi-card">
            <div class="label">Lucro Estimado</div>
            <div class="value terracota">@_dados.LucroEstimadoMes.ToString("C", _ptBr)</div>
            <div class="sub">@_dados.MargemPercentual% de margem</div>
        </div>
    </div>

    <div class="card table-card">
        <div style="padding:20px 20px 0"><div class="card-title">Margem por Produto</div></div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Tipo</th>
                    <th>Custo/un.</th>
                    <th>Preço Venda</th>
                    <th>Lucro/un.</th>
                    <th>Margem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _dados.Margens.Where(m => m.Ativo))
                {
                    <tr>
                        <td><strong>@m.Nome</strong></td>
                        <td><TipoBadge Tipo="@m.Tipo" /></td>
                        <td class="custo">@m.Custo.ToString("C", _ptBr)</td>
                        <td>@m.Preco.ToString("C", _ptBr)</td>
                        <td class="lucro">@m.Lucro.ToString("C", _ptBr)</td>
                        <td>
                            <div class="margin-bar">
                                <div class="margin-bar-track">
                                    <div class="margin-bar-fill @(m.Margem >= 60 ? "high" : "low")" style="width:@m.Margem%"></div>
                                </div>
                                <span style="font-weight:700;font-size:13px">@m.Margem%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private CustosDto? _dados;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");

    protected override async Task OnInitializedAsync() => _dados = await Custos.ObterAsync();
}

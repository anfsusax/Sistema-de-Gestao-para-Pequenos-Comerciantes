@page "/unidades/novo"
@page "/unidades/editar/{Id:int}"
@rendermode InteractiveServer
@inject UnidadeMedidaService Unidades
@inject NavigationManager Nav

<PageTitle>@(_editando ? "Editar" : "Nova") Unidade — SalgadosPro</PageTitle>

<div class="page-header">
    <div><h1>@(_editando ? "Editar Unidade" : "Nova Unidade")</h1></div>
    <a href="/unidades" class="btn btn-secondary">← Voltar</a>
</div>

@if (!string.IsNullOrEmpty(_erro))
{
    <div class="card" style="margin-bottom:16px;padding:12px 16px;border-left:4px solid #c0392b">@_erro</div>
}

<div class="card form-card">
    <EditForm Model="_unidade" OnValidSubmit="Salvar">
        <div class="form-row">
            <div class="form-group">
                <label>Sigla *</label>
                <InputText class="form-control" @bind-Value="_unidade.Sigla" placeholder="Ex: UN" maxlength="10" />
            </div>
            <div class="form-group">
                <label>Nome *</label>
                <InputText class="form-control" @bind-Value="_unidade.Nome" placeholder="Ex: Unidade" maxlength="80" />
            </div>
        </div>
        <div class="form-group">
            <label><InputCheckbox @bind-Value="_unidade.Ativo" /> Unidade ativa</label>
        </div>
        <div style="display:flex;gap:12px">
            <a href="/unidades" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@_salvando">@(_salvando ? "Salvando..." : "Salvar")</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private UnidadeMedida _unidade = new() { Ativo = true };
    private bool _editando;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            _editando = true;
            var u = await Unidades.ObterAsync(Id);
            if (u != null) _unidade = u;
        }
    }

    private async Task Salvar()
    {
        _salvando = true;
        _erro = null;
        try
        {
            await Unidades.SalvarAsync(_unidade);
            Nav.NavigateTo("/unidades");
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _salvando = false; }
    }
}
